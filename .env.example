# TEMPLATE ONLY — this file IS committed to git.
# Put real values in .env (gitignored), never here.

# ---------------------------------------------------------------
# Anthropic API key — powers recipe URL import and the AI chat.
# Get one at https://console.anthropic.com -> Settings -> API Keys
# Starts with "sk-ant-api03-".
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# Shared passcode for the AI chat panels. Anyone who knows it can
# spend your Anthropic credits, so pick something non-obvious.
# Browsing recipes does not require it.
# ---------------------------------------------------------------
CHAT_PASSCODE=

# ---------------------------------------------------------------
# Turso database (already in use for recipes).
# turso db show aralynns-cookbook --url
# turso db tokens create aralynns-cookbook
# ---------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
